# ==============================================================================
# HACHIHI QUIZ - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# QUY TẮC BẢO MẬT:
# 1. KHÔNG BAO GIỜ commit file .env chứa giá trị thật lên GitHub.
# 2. Sử dụng GitHub Secrets và Cloudflare Secrets (wrangler secret put) cho production.
# 3. Để chạy local: Copy file này thành .env và điền các giá trị phát triển.
# ==============================================================================

# 1. Ứng dụng & Máy chủ (App Runtime)
NODE_ENV="development" # "development" | "staging" | "production"
PORT=3000
APP_URL="http://localhost:3000"

# 2. Giới hạn phòng & Phân quyền tổ chức (HACHIHI Organization Policy)
MAX_ROOM_CAPACITY=50
ALLOWED_WORKSPACE_DOMAINS="hachihi.vn,gmail.com"
ADMIN_EMAILS="admin@hachihi.vn,haihoang.hch@gmail.com"

# 3. Google Workspace OAuth 2.0 (Host & Admin Sign-in)
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials
# Lưu ý: Client Secret chỉ lưu trên Cloudflare Secrets hoặc Server-side!
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET" # Set via: wrangler secret put GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# 4. Bảo mật JWT & Phiên làm việc (Session Security)
# Sinh chuỗi bí mật: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_SUPER_SECRET_KEY" # Set via: wrangler secret put JWT_SECRET
JWT_EXPIRES_IN="7d"

# 5. Cloudflare Deployment Credentials (Dành cho CI/CD GitHub Actions)
# Cấu hình trong: GitHub Repo -> Settings -> Secrets and variables -> Actions
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_with_workers_and_d1_edit_permissions"

# 6. Cloudflare D1 Database IDs (Tạo bằng lệnh: wrangler d1 create hachihi-quiz-db)
CLOUDFLARE_D1_DATABASE_ID_STAGING="staging-db-uuid-here"
CLOUDFLARE_D1_DATABASE_ID_PROD="prod-db-uuid-here"

# 7. AI Studio & Google Gemini API (Tùy chọn sinh đề tự động)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
